<?xml version="1.0" encoding="UTF-8"?>
<xsl:stylesheet version="1.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:atom="http://www.w3.org/2005/Atom">
<xsl:output method="html" encoding="UTF-8"/>
<xsl:template match="/">
<html><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>运维 Runbook · RSS</title><style>body{margin:0;background:#fff;color:#1f2328;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI","PingFang SC","Microsoft YaHei",sans-serif;line-height:1.75}.top{background:#f6f8fa;border-bottom:1px solid #e5e7eb;padding:48px 20px}.shell{max-width:820px;margin:auto}.mark{color:#0f766e;font:600 12px ui-monospace,Consolas,monospace;text-transform:uppercase;letter-spacing:.5px}.top h1{font-size:36px;margin:8px 0;font-weight:700;letter-spacing:0}.top p{color:#57606a}.list{padding:32px 20px 64px}.entry{display:block;padding:22px 0;border-bottom:1px solid #e5e7eb;color:inherit;text-decoration:none}.entry h2{font-size:20px;margin:4px 0;font-weight:600}.entry time{color:#0f766e;font:600 12px ui-monospace,Consolas,monospace}.entry p{color:#57606a;margin:8px 0}.hint{background:#f6f8fa;border:1px solid #e5e7eb;border-radius:8px;padding:14px 16px;margin-bottom:16px}code{overflow-wrap:anywhere}@media(max-width:600px){.top h1{font-size:28px}.entry h2{font-size:17px}}</style></head><body><section class="top"><div class="shell"><div class="mark">ATOM FEED</div><h1><xsl:value-of select="atom:feed/atom:title"/></h1><p>这是可订阅的文章更新流。复制当前地址到 RSS 阅读器，或直接浏览最近内容。</p></div></section><main class="shell list"><div class="hint">订阅地址：<code><xsl:value-of select="atom:feed/atom:link[@rel='self']/@href"/></code></div><xsl:for-each select="atom:feed/atom:entry"><a class="entry"><xsl:attribute name="href"><xsl:value-of select="atom:link/@href"/></xsl:attribute><time><xsl:value-of select="substring(atom:updated,1,10)"/></time><h2><xsl:value-of select="atom:title"/></h2><p><xsl:value-of select="atom:summary"/></p></a></xsl:for-each></main></body></html>
</xsl:template></xsl:stylesheet>
